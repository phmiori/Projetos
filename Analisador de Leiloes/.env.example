# Copie este arquivo para ".env" e preencha com o seu login do BuscaAii.
# O .env fica só no seu computador; nunca compartilhe esse arquivo.
BUSCAAII_EMAIL=seu_email@exemplo.com
BUSCAAII_SENHA=sua_senha

# Opcional: token da API FIPE (https://fipe.online) para aumentar o limite diário de consultas
FIPE_TOKEN=
