// SQL/schema.prisma
// Configuração do Prisma ORM para o Sistema de Gestão de Carros de Leilão (AutoLeilão Hub)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Veiculo {
  id              Int       @id @default(autoincrement())

  // Dono do Cadastro
  usuarioId       Int
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // 1. Dados Gerais
  marca           String
  modelo          String
  ano             Int
  placa           String?
  chassi          String?
  origem          String    @default("Seguradora") // Seguradora, Banco, Frota, etc.
  leiloeiro       String?   // Ex: Sodré Santoro, Freitas, Copart
  dataCompra      DateTime? // Data de aquisição/arremate
  status          String    @default("Em Trânsito") // Em Trânsito, Em Preparação, Regularização, Anunciado, Vendido
  observacoes     String?

  // 2. Custos de Aquisição
  valorArremate   Float     @default(0)
  comissaoPct     Float     @default(5)
  taxasPatio      Float     @default(0)
  custoGuincho    Float     @default(0)
  totalAquisicao  Float     @default(0)

  // Método de Arrematação: À Vista ou Parcelado (25% de entrada sobre o lance, sem a comissão do leiloeiro)
  metodoPagamento String    @default("À Vista")
  valorEntrada    Float     @default(0)
  valorParcelado  Float     @default(0)
  qtdParcelas     Int       @default(0)
  valorParcela    Float     @default(0)

  // 3. Custos de Preparação e Regularização
  gastoMecanica     Float   @default(0)
  gastoFunilaria    Float   @default(0)
  gastoEstetica     Float   @default(0)
  gastoDocumentacao Float   @default(0)
  totalPreparacao   Float   @default(0)

  // 4. Dados de Venda e Margem
  custoTotal      Float     @default(0)
  precoAnuncio    Float?
  valorVenda      Float?
  dataVenda       DateTime?
  lucroBruto      Float?
  roiPct          Float?

  // Relacionamento com Gastos Detalhados
  gastos          GastoVeiculo[]

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Usuario {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  nome        String
  senhaHash   String
  role        String   @default("usuario") // "admin" (Davi_olp e PhMiori) ou "usuario" (contas criadas pelos admins)
  fotoUrl     String?  // Foto de perfil em Data URL (Base64), definida em Configurações
  email       String?  // Usado para envio de alertas (ex.: queda de preço de FII)

  // Chave de grupo: usuários com o mesmo valor (não nulo) compartilham entre si os
  // cadastros do módulo Carros de Leilão (veem e editam os veículos uns dos outros)
  grupoLeilaoCarros String?

  veiculos    Veiculo[]
  imoveis     ImovelLeilao[]
  investimentosFII InvestimentoFII[]
  investimentosCripto InvestimentoCripto[]
  cofrinhos   Cofrinho[]
  eventos     Evento[]
  locaisClimaSalvos LocalClimaSalvo[]
  contasBancarias      ContaBancaria[]
  cartoesCredito       CartaoCredito[]
  categoriasFinanceiras CategoriaFinanceira[]
  transacoesFinanceiras Transacao[]
  blocosTreino   BlocoTreino[]
  registrosSaude RegistroSaude[]
  veiculosGaragem VeiculoGaragem[]
  modulosOcultos  ModuloOculto[]
  notificacoesDispensadas NotificacaoDispensada[]
  fiiWatchlist    FiiWatchlist[]
  pushSubscriptions PushSubscription[]
  pushTokensExpo    PushTokenExpo[]
  pushNotificacoesEnviadas PushNotificacaoEnviada[]
  mensagensAssistente MensagemAssistente[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * Histórico de conversa do Assistente de IA (módulo Assistente): cada linha é uma mensagem,
 * do usuário ou da IA, usada para manter contexto entre perguntas e para reexibir a conversa
 * ao reabrir o módulo. `papel` é 'usuario' ou 'assistente'.
 */
model MensagemAssistente {
  id        Int      @id @default(autoincrement())

  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  papel     String
  conteudo  String

  createdAt DateTime @default(now())
}

model ModuloOculto {
  id        Int      @id @default(autoincrement())

  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  modulo    String   // Chave do módulo do Hub Financeiro ocultado: fii, cripto, leilao, casasleilao, cofrinho

  createdAt DateTime @default(now())

  @@unique([usuarioId, modulo])
}

/**
 * Registro genérico de "notificação dispensada" para tipos de notificação do sino que não têm
 * um campo próprio (como Evento.notificacaoDispensada) — hoje usado por Despensa (estoque baixo)
 * e Tarefas (vencidas), extensível a novos tipos sem precisar de uma migração por tipo.
 */
model NotificacaoDispensada {
  id         Int      @id @default(autoincrement())

  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tipo       String   // 'fatura' (FaturaCartao vencendo)
  entidadeId Int

  createdAt  DateTime @default(now())

  @@unique([usuarioId, tipo, entidadeId])
}

/**
 * Alerta de preço de FII que o usuário NÃO possui na carteira (lista de observação) —
 * separado de InvestimentoFII porque não representa uma posição (sem cotas/preço médio).
 */
model FiiWatchlist {
  id                  Int       @id @default(autoincrement())

  usuarioId           Int
  usuario             Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  ticker              String
  alertaPrecoAbaixoDe Float
  alertaDisparado     Boolean   @default(false)

  precoAtual          Float?
  precoAtualizadoEm   DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/**
 * Inscrição de push do navegador (Web Push API) de um dispositivo do usuário — uma pessoa pode
 * ter várias (celular, notebook, etc.), cada endpoint é único por definição do próprio navegador.
 */
model PushSubscription {
  id        Int      @id @default(autoincrement())

  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  endpoint  String   @unique
  p256dh    String
  auth      String

  createdAt DateTime @default(now())
}

/**
 * Token de push do Expo (app mobile React Native, pasta App/) — mesma ideia do
 * PushSubscription (Web Push do navegador), mas pro app nativo, que usa o serviço de push do
 * Expo (https://exp.host) em vez de VAPID/Web Push. Reaproveitado pelo mesmo cron de
 * lib/push-shared.js que já envia Web Push.
 */
model PushTokenExpo {
  id        Int      @id @default(autoincrement())

  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  token     String   @unique

  createdAt DateTime @default(now())
}

/**
 * Marca que uma notificação (evento com lembrete, fatura vencendo, etc.) já foi enviada por
 * push a este usuário, para o cron de push (a cada 5 min) não reenviar a cada execução —
 * mesmo padrão do NotificacaoDispensada, mas para "já enviada" em vez de "usuário dispensou".
 */
model PushNotificacaoEnviada {
  id         Int      @id @default(autoincrement())

  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tipo       String   // 'evento' ou 'fatura'
  entidadeId Int

  createdAt  DateTime @default(now())

  @@unique([usuarioId, tipo, entidadeId])
}

model VeiculoGaragem {
  id              Int       @id @default(autoincrement())

  usuarioId       Int
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  marca           String
  modelo          String
  ano             Int
  placa           String?
  cor             String?
  quilometragem   Float?

  dataCompra      DateTime
  valorCompra     Float     @default(0)

  status          String    @default("Ativo") // Ativo, Vendido
  dataVenda       DateTime?
  valorVenda      Float?

  observacoes     String?

  manutencoes     ManutencaoGaragem[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ManutencaoGaragem {
  id              Int             @id @default(autoincrement())

  veiculoId       Int
  veiculo         VeiculoGaragem  @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  data            DateTime        @default(now())
  categoria       String          // Troca de Óleo, Troca de Pneu, Revisão, Freios, Suspensão, Bateria, Elétrica, Funilaria/Pintura, Documentação/IPVA, Outros
  descricao       String
  valor           Float           @default(0)
  oficina         String?
  quilometragem   Float?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model BlocoTreino {
  id          Int       @id @default(autoincrement())

  usuarioId   Int
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  nome        String
  diaSemana   String?   // Segunda, Terça, Quarta, Quinta, Sexta, Sábado, Domingo (null = sem dia definido)
  observacoes String?
  ordem       Int       @default(0)

  exercicios  ExercicioTreino[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ExercicioTreino {
  id          Int         @id @default(autoincrement())

  blocoId     Int
  bloco       BlocoTreino @relation(fields: [blocoId], references: [id], onDelete: Cascade)

  nome        String
  series      Int?
  repeticoes  String?
  carga       String?
  observacoes String?
  ordem       Int         @default(0)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model RegistroSaude {
  id          Int       @id @default(autoincrement())

  usuarioId   Int
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  data        DateTime  @default(now())
  peso        Float?
  cintura     Float?
  aguaMl      Int?
  sonoHoras   Float?
  observacoes String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/**
 * Módulo Finanças (controle bancário pessoal): contas, cartões de crédito, categorias,
 * transações (receitas/despesas/transferências) e faturas de cartão geradas por ciclo.
 */
model ContaBancaria {
  id            Int       @id @default(autoincrement())

  usuarioId     Int
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  nome          String
  banco         String
  tipo          String    @default("Corrente") // Corrente, Poupança, Carteira Digital
  saldoInicial  Float     @default(0)
  cor           String    @default("#EEBB00")
  ativa         Boolean   @default(true)

  cartoes       CartaoCredito[]
  transacoes    Transacao[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CartaoCredito {
  id               Int       @id @default(autoincrement())

  usuarioId        Int
  usuario          Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  nome             String
  banco            String
  bandeira         String    @default("Visa") // Visa, Mastercard, Elo, Amex, Outro
  limite           Float     @default(0)
  diaFechamento    Int       // dia do mês (1-31) em que a fatura fecha
  diaVencimento    Int       // dia do mês (1-31) em que a fatura vence
  cor              String    @default("#EEBB00")
  ativo            Boolean   @default(true)

  contaVinculadaId Int?
  contaVinculada   ContaBancaria? @relation(fields: [contaVinculadaId], references: [id], onDelete: SetNull)

  transacoes       Transacao[]
  faturas          FaturaCartao[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model CategoriaFinanceira {
  id              Int       @id @default(autoincrement())

  usuarioId       Int
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  nome            String
  tipo            String    @default("Despesa") // Receita, Despesa
  cor             String    @default("#A0A0A0")
  orcamentoMensal Float?    // limite mensal opcional, usado para alerta de orçamento estourado

  transacoes      Transacao[]

  createdAt       DateTime  @default(now())

  @@unique([usuarioId, nome, tipo])
}

model FaturaCartao {
  id             Int           @id @default(autoincrement())

  cartaoId       Int
  cartao         CartaoCredito @relation(fields: [cartaoId], references: [id], onDelete: Cascade)

  mesReferencia  Int           // 1-12
  anoReferencia  Int
  dataFechamento DateTime
  dataVencimento DateTime
  status         String        @default("Aberta") // Aberta, Fechada, Paga
  dataPagamento  DateTime?

  transacoes     Transacao[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([cartaoId, mesReferencia, anoReferencia])
}

model Transacao {
  id                  Int       @id @default(autoincrement())

  usuarioId           Int
  usuario             Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tipo                String    // Receita, Despesa, Transferencia
  descricao           String
  valor               Float     @default(0)
  data                DateTime  @default(now())
  formaPagamento      String    @default("Débito") // Débito, Crédito, Pix, Dinheiro, Boleto, Transferência
  status              String    @default("Pago")   // Pago, Pendente, Agendado
  recorrente          Boolean   @default(false)
  // Corrente de recorrência: aponta para a transação que originou esta (a cada mês vencido,
  // o cron gera a próxima e marca a origem como "já gerada", ver lib/financas-shared.js).
  recorrenciaOrigemId Int?
  recorrenciaOrigem   Transacao?  @relation("RecorrenciaChain", fields: [recorrenciaOrigemId], references: [id], onDelete: SetNull)
  recorrenciaProxima  Transacao[] @relation("RecorrenciaChain")
  recorrenciaProximaGerada Boolean @default(false)

  categoriaId         Int?
  categoria           CategoriaFinanceira? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  contaId             Int?      // conta de origem (débito/pix/dinheiro/boleto) ou de saída em transferência
  conta               ContaBancaria? @relation(fields: [contaId], references: [id], onDelete: SetNull)

  contaDestinoId      Int?      // conta de destino, usado apenas quando tipo = Transferencia

  cartaoId            Int?
  cartao              CartaoCredito? @relation(fields: [cartaoId], references: [id], onDelete: SetNull)

  faturaId            Int?
  fatura              FaturaCartao? @relation(fields: [faturaId], references: [id], onDelete: SetNull)

  grupoParcelamentoId String?   // agrupa as parcelas de uma mesma compra parcelada
  parcelaAtual        Int?
  parcelaTotal        Int?

  dividendoFii        DividendoFii?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model LocalClimaSalvo {
  id        Int      @id @default(autoincrement())

  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  nome      String
  estado    String?
  pais      String?
  lat       Float
  lon       Float

  favoritoHeader Boolean @default(false)

  createdAt DateTime @default(now())
}

model Evento {
  id              Int       @id @default(autoincrement())

  usuarioId       Int
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  titulo          String
  descricao       String?
  local           String?
  inicio          DateTime
  fim             DateTime
  diaTodo         Boolean   @default(false)
  cor             String    @default("#EEBB00")
  lembreteMinutos Int?      // Minutos de antecedência para o sino de notificação (null = sem lembrete)
  notificacaoDispensada Boolean @default(false) // true quando o usuário exclui a notificação no sino (o evento em si não é apagado)

  // Recorrência: quando o evento é criado com "repetir" semanal/mensal, todas as ocorrências
  // geradas de uma vez compartilham este UUID (usado para excluir "esta e as futuras" juntas).
  serieRecorrenciaId String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ImovelLeilao {
  id              Int       @id @default(autoincrement())

  // Dono do Cadastro
  usuarioId       Int
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // 1. Dados Gerais
  endereco        String
  cidade          String?
  uf              String?
  tipoImovel      String    @default("Casa") // Casa, Apartamento, Terreno, Comercial, Rural, Outro
  areaM2          Float?
  quartos         Int?
  banheiros       Int?
  matricula       String?   // Nº de Matrícula no Registro de Imóveis
  origem          String    @default("Banco") // Banco, Judicial, Extrajudicial, Prefeitura, Outro
  leiloeiro       String?   // Ex: Sodré Santoro, Zukerman, Leilão Judicial TJ
  dataCompra      DateTime? // Data de aquisição/arremate
  status          String    @default("Em Desocupação") // Em Desocupação, Em Regularização, Em Reforma, Anunciado, Vendido
  observacoes     String?

  // 2. Custos de Aquisição
  valorArremate     Float   @default(0)
  comissaoPct       Float   @default(5)
  custasProcessuais Float   @default(0)
  custoDesocupacao  Float   @default(0)
  totalAquisicao    Float   @default(0)

  // 3. Custos de Preparação e Regularização
  gastoReforma      Float   @default(0)
  gastoAcabamento   Float   @default(0)
  gastoLimpeza      Float   @default(0)
  gastoDocumentacao Float   @default(0)
  totalPreparacao   Float   @default(0)

  // 4. Dados de Venda e Margem
  custoTotal      Float     @default(0)
  precoAnuncio    Float?
  valorVenda      Float?
  dataVenda       DateTime?
  lucroBruto      Float?
  roiPct          Float?

  // Relacionamento com Gastos Detalhados
  gastos          GastoImovel[]

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GastoImovel {
  id          Int          @id @default(autoincrement())
  imovelId    Int
  imovel      ImovelLeilao @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  data        DateTime @default(now())
  categoria   String   // Taxa Leilão / Processual, Desocupação, Reforma, Acabamento / Pintura, Documentação / Cartório, Limpeza, Outros
  descricao   String   // Ex: Pintura completa e troca de piso da sala
  fornecedor  String?  // Ex: Construtora Silva
  valor       Float    @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Cofrinho {
  id              Int       @id @default(autoincrement())

  usuarioId       Int
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  nome            String
  valorInvestido  Float     @default(0)
  rendaPorDia     Float     @default(0) // Renda recebida no dia 1 (R$), usada como base fixa diária (juros simples)
  dataInicio      DateTime  @default(now())
  observacoes     String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model InvestimentoFII {
  id                Int       @id @default(autoincrement())

  usuarioId         Int
  usuario           Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  ticker            String
  segmento          String    @default("Papel / CRI")
  cotas             Int       @default(0)
  precoMedio        Float     @default(0)
  ultimoDividendo   Float     @default(0)
  observacoes       String?

  // Cotação de mercado obtida automaticamente (Yahoo Finance)
  precoAtual        Float?
  precoAtualizadoEm DateTime?

  // Alerta por e-mail de queda de preço
  alertaPrecoAbaixoDe Float?   // se definido, envia e-mail quando precoAtual cruzar abaixo deste valor
  alertaDisparado     Boolean  @default(false) // evita reenviar o alerta enquanto o preço não se recuperar acima do limite

  historicoPrecos   HistoricoPrecoFii[]
  dividendos        DividendoFii[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/**
 * Registro de um dividendo/rendimento efetivamente recebido (data + valor), diferente do
 * campo `ultimoDividendo` (só usado pra projetar a renda mensal). Ao ser criado, atualiza
 * `ultimoDividendo` do FII com o valor por cota e, se uma conta bancária for informada, gera
 * uma Transacao de Receita vinculada (ver POST /api/fii/:id/dividendos), contabilizando o
 * valor recebido no saldo real do módulo Finanças.
 */
model DividendoFii {
  id             Int             @id @default(autoincrement())

  investimentoId Int
  investimento   InvestimentoFII @relation(fields: [investimentoId], references: [id], onDelete: Cascade)

  data           DateTime
  valorTotal     Float
  valorPorCota   Float

  transacaoId    Int?            @unique
  transacao      Transacao?      @relation(fields: [transacaoId], references: [id], onDelete: SetNull)

  createdAt      DateTime        @default(now())
}

/**
 * Snapshot diário do preço de mercado de um FII da carteira, gravado toda vez que a cotação é
 * atualizada (botão "Atualizar Cotações", cron de alerta ou cron diário de histórico) — no
 * máximo um registro por dia por FII (@@unique), usado para o gráfico de evolução da cota.
 */
model HistoricoPrecoFii {
  id             Int             @id @default(autoincrement())

  investimentoId Int
  investimento   InvestimentoFII @relation(fields: [investimentoId], references: [id], onDelete: Cascade)

  dia            DateTime        // truncado para meia-noite UTC do dia do snapshot
  preco          Float

  createdAt      DateTime        @default(now())

  @@unique([investimentoId, dia])
}

model InvestimentoCripto {
  id                Int       @id @default(autoincrement())

  usuarioId         Int
  usuario           Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  moedaId           String    // Slug da CoinGecko usado para buscar cotação (Ex: bitcoin, ethereum)
  ticker            String    // Símbolo de exibição (Ex: BTC, ETH)
  nome              String    // Nome de exibição (Ex: Bitcoin, Ethereum)
  categoria         String    @default("Layer 1") // Layer 1, Layer 2, DeFi, Meme, Stablecoin, Outro
  quantidade        Float     @default(0)
  precoMedio        Float     @default(0) // Preço médio de compra em R$
  observacoes       String?

  // Cotação de mercado obtida automaticamente (CoinGecko)
  precoAtual        Float?
  precoAtualizadoEm DateTime?

  // Alerta por e-mail de queda de preço (mesmo mecanismo do módulo FII)
  alertaPrecoAbaixoDe Float?   // se definido, envia e-mail quando precoAtual cruzar abaixo deste valor
  alertaDisparado     Boolean  @default(false) // evita reenviar o alerta enquanto o preço não se recuperar acima do limite

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model GastoVeiculo {
  id          Int      @id @default(autoincrement())
  veiculoId   Int
  veiculo     Veiculo  @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  
  data        DateTime @default(now())
  categoria   String   // Taxa Leiloeiro / Pátio, Guincho, Mecânica, Funilaria / Pintura, Documentação, Estética, Outros
  descricao   String   // Ex: Revisão geral: troca de óleo 0W20 e pastilhas
  oficina     String?  // Ex: Auto Mecânica Paulista
  valor       Float    @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

