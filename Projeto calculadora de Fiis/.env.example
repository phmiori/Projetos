# Conexão com o banco Postgres (Neon)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Porta do servidor (opcional, padrão 3000)
PORT=3000

# Chave de sessão (opcional em dev, recomendado em produção)
SESSION_SECRET="troque-por-uma-chave-aleatoria"

# E-mail (Gmail) usado para enviar os alertas de queda de preço de FII.
# 1. Ative a verificação em 2 etapas na conta Google: https://myaccount.google.com/security
# 2. Gere uma "senha de app" em: https://myaccount.google.com/apppasswords
# 3. Use o e-mail da conta em SMTP_USER e a senha de app (16 caracteres, sem espaços) em SMTP_PASS
#
# NUNCA coloque valores reais neste arquivo (.env.example é versionado no git).
# Valores reais vão no arquivo .env (que está no .gitignore e não é versionado).
SMTP_USER="seuemail@gmail.com"
SMTP_PASS="senha-de-app-de-16-caracteres"

# Notificações Web Push (lembrete de evento e fatura vencendo mesmo com o app fechado).
# Gere seu próprio par de chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="chave-publica-vapid"
VAPID_PRIVATE_KEY="chave-privada-vapid"
VAPID_SUBJECT="mailto:seuemail@exemplo.com"

# Assistente de IA (chat, sugestões de investimento e envio de e-mails via chat).
# Usa a API gratuita do Google Gemini (não precisa de plano pago).
# 1. Crie uma chave gratuita em: https://aistudio.google.com/apikey
# 2. Cole a chave abaixo.
GEMINI_API_KEY="sua-chave-gratuita-do-gemini"
# Radar de Oportunidades (aba dentro de Carros de Leilão).
# Login da SUA conta do BuscaAii (https://www.buscaaii.com.br), usado para baixar os carros de
# leilão judicial. No Render, cadastre estas variáveis em Environment.
BUSCAAII_EMAIL="seuemail@exemplo.com"
BUSCAAII_SENHA="sua-senha-do-buscaaii"
# Opcional: token da API FIPE (https://fipe.online) para passar do limite gratuito de ~1000 consultas/dia
FIPE_TOKEN=""
