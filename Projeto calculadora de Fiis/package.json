{
  "name": "autoleilao-hub",
  "version": "1.0.0",
  "description": "Sistema de Gestão de Compra, Reforma e Venda de Carros de Leilão",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env --watch server.js",
    "test": "node --test",
    "prisma:generate": "prisma generate --schema=./SQL/schema.prisma",
    "prisma:push": "prisma db push --schema=./SQL/schema.prisma",
    "prisma:studio": "prisma studio --schema=./SQL/schema.prisma"
  },
  "keywords": [
    "leilao",
    "carros",
    "financeiro",
    "gestao",
    "prisma"
  ],
